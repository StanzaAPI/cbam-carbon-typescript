    }
  },
  "keywords": [
    "cbam",
    "carbon-tax",
    "eu-ets",
    "embedded-emissions",
    "scope-1",
    "scope-2",
    "carbon-border-tax",
    "regulation-2023-956",
    "customs-compliance"
  ],
  "author": "Stanza",
  "license": "MIT",
  "homepage": "https://stanzaapi.com/tools/cbam-carbon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanzaAPI/cbam-carbon-typescript.git"
  }
}